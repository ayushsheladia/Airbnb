<% layout('/layouts/boilerplate') -%>

<body>
    <h3>Edit your Place</h3>
    <form action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" method="post">
        <br><br>
        <div class="mb-1">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control" style="width: 400px;" required>
        </div>
        <br><br>
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description" class="form-control" required ><%=listing.description%></textarea>
        </div>
        <br><br>
        <div>
            <label for="image" class="form-label">Image</label>
            <input type="text" name="listing[image]" class="form-control" required value="<%=listing.image%>">
        </div>
        <br><br>
        <div class="row">

            <div class="col-4">
                <label for="price" class="form-label">Price</label>
                <input type="number" name="listing[price]" class="form-control" required value=<%=listing.price%>>
            </div>
            <br><br>
            <div class="col-8">
                <label for="country" class="form-label">Country</label>
                <input type="text" name="listing[country]" class="form-control" required value="<%=listing.country%>" style="width: 400px;">
            </div>
        </div>
        <br><br>
        <div>
             <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" class="form-control"  required value="<%=listing.location%>">
        </div>
        <br><br>
        <button class="btn btn-dark editbtn">Edit</button>
        <br><br>
    </form>
</body>

