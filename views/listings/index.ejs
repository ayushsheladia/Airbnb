<% layout('/layouts/boilerplate') -%>
>
<body>

    <h3>All Listings</h3>

    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-2">

        <% for(let listing of alllisting){ %>
            <a class="listing_link" href="/listings/<%=listing._id%>">

                <div class="col mb-4">
                    
                    <div class="card h-100">

                    <img
                        src="<%= listing.image %>"
                        class="card-img-top"
                        alt="listing-image"
                        style="height:20rem"
                        >
                        
                        <div class="card-body">
                            
                        <p class="card-text">

                            <b><%= listing.title %></b>

                            <br>
                            
                            ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>/night
                            
                        </p>
                        
                    </div>
                    <div class="card-img-overlay"></div>
                    
                </div>
                
            </div>
        </a>
            
        <% } %>

    </div>

</body>